# Optional: leave empty to run in DEMO MODE with localStorage.
# Add Firebase values to enable Firestore/Auth/Storage.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional AI endpoint. If empty, the app uses a local demo tutor.
VITE_AI_TUTOR_ENDPOINT=
