# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Frontend AI endpoint. Keep this same-origin on Vercel.
VITE_AI_TUTOR_ENDPOINT=/api/tutor

# Server-side only. Never expose GEMINI_API_KEY with VITE_.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TUTOR_THINKING=low
GEMINI_CORRECTION_THINKING=medium
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2

# Optional future provider/fallback configuration.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1/responses
